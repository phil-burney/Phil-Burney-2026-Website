---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Platform | Phil Burney for Commissioner"
  description="Phil Burney's platform for Rutherford County Commissioner, District 5."
>
  <section class="section platform-intro">
    <p class="tag">Platform</p>
    <h1>A clear plan for District 5</h1>
    <p class="muted lead">
      A focused agenda to keep Rutherford County strong, safe, and prepared for the future.
      Click any issue to read Phil's full position.
    </p>
  </section>

  <section class="section issues-grid">
    <a href="/platform/education" class="issue-card">
      <div class="issue-body">
        <h2>Education</h2>
        <p class="muted">Fund our schools, modernize facilities, and build workforce pathways.</p>
      </div>
      <span class="issue-arrow">→</span>
    </a>

    <a href="/platform/job-creation" class="issue-card">
      <div class="issue-body">
        <h2>Job Creation</h2>
        <p class="muted">Attract quality employers, support small businesses, and develop local talent.</p>
      </div>
      <span class="issue-arrow">→</span>
    </a>

    <a href="/platform/mental-health" class="issue-card">
      <div class="issue-body">
        <h2>Mental Health</h2>
        <p class="muted">Invest in crisis services, community care, and youth mental health.</p>
      </div>
      <span class="issue-arrow">→</span>
    </a>

    <a href="/platform/infrastructure" class="issue-card">
      <div class="issue-body">
        <h2>Infrastructure</h2>
        <p class="muted">Fix roads, address drainage, and plan for the county's growth.</p>
      </div>
      <span class="issue-arrow">→</span>
    </a>

    <a href="/platform/housing" class="issue-card">
      <div class="issue-body">
        <h2>Housing</h2>
        <p class="muted">Protect neighborhoods, create attainable options, and hold developers accountable.</p>
      </div>
      <span class="issue-arrow">→</span>
    </a>

    <a href="/platform/taxes" class="issue-card">
      <div class="issue-body">
        <h2>Taxes &amp; Fiscal Policy</h2>
        <p class="muted">Transparent budgets, responsible spending, and fair property taxes.</p>
      </div>
      <span class="issue-arrow">→</span>
    </a>

    <a href="/platform/government-transparency" class="issue-card">
      <div class="issue-body">
        <h2>Government Transparency</h2>
        <p class="muted">Open meetings, accessible public records, and ethical, accountable leadership.</p>
      </div>
      <span class="issue-arrow">→</span>
    </a>

    <a href="/platform/government-modernization" class="issue-card">
      <div class="issue-body">
        <h2>Government Modernization</h2>
        <p class="muted">Automate routine services and build collaboration across county departments.</p>
      </div>
      <span class="issue-arrow">→</span>
    </a>
  </section>

  <section class="cta-section">
    <div class="cta-inner">
      <h2>Let's talk about your priorities</h2>
      <p>Phil wants to hear from District 5 residents. Share what matters most to you.</p>
      <div class="cta-actions">
        <a href="/donations" class="btn btn-primary">Support the Campaign</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .platform-intro {
    padding-top: 3rem;
  }

  .platform-intro h1 {
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--brand);
    margin: 0.5rem 0 1rem;
  }

  .lead {
    font-size: 1.15rem;
    max-width: 620px;
    line-height: 1.7;
  }

  .issues-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .issue-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--brand);
    border-radius: 0.5rem;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
    transition: border-left-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .issue-card:hover {
    border-left-color: var(--accent);
    box-shadow: 0 4px 16px rgba(15, 47, 103, 0.1);
    transform: translateY(-2px);
  }

  .issue-body {
    flex: 1;
  }

  .issue-body h2 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--brand);
    margin-bottom: 0.3rem;
    border: none;
  }

  .issue-body p {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .issue-arrow {
    font-size: 1.25rem;
    color: var(--muted);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .issue-card:hover .issue-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }
</style>
