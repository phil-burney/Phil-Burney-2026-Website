---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Platform | Phil Burney">
  <section class="section hero">
    <div>
      <p class="tag">Platform</p>
      <h1 class="title">Leading District 5 with a clear plan</h1>
      <p class="muted">
        A focused agenda to keep Rutherford County strong, safe, and prepared for the future.
      </p>
    </div>
    <img src="/placeholder-hero.svg" alt="Platform hero placeholder" />
  </section>

  <section class="section grid grid-2">
    <article class="card">
      <h2>Responsible Growth</h2>
      <p class="muted">
        Balance new development with infrastructure investments to protect neighborhoods and
        keep traffic moving.
      </p>
      <ul>
        <li>Transparent zoning decisions</li>
        <li>Neighborhood impact reviews</li>
        <li>Protect green spaces</li>
      </ul>
    </article>
    <article class="card">
      <h2>Public Safety</h2>
      <p class="muted">
        Support first responders and ensure county resources are ready for emergencies.
      </p>
      <ul>
        <li>Modernize equipment</li>
        <li>Coordinate county-wide response</li>
        <li>Community policing partnerships</li>
      </ul>
    </article>
    <article class="card">
      <h2>Fiscal Accountability</h2>
      <p class="muted">
        Keep taxes responsible and deliver results that residents can measure.
      </p>
      <ul>
        <li>Open budget dashboards</li>
        <li>Outcome-based spending</li>
        <li>Regular town halls</li>
      </ul>
    </article>
    <article class="card">
      <h2>Quality of Life</h2>
      <p class="muted">
        Invest in parks, schools, and services that make District 5 a great place to live.
      </p>
      <ul>
        <li>Support local schools</li>
        <li>Expand recreation options</li>
        <li>Improve county services</li>
      </ul>
    </article>
  </section>

  <section class="section card">
    <h2 class="section-title">Let’s talk about your priorities</h2>
    <p class="muted">
      Phil wants to hear from you. Share what matters most in District 5 and help shape the agenda.
    </p>
    <button class="btn btn-primary">Share Your Ideas</button>
  </section>
</BaseLayout>



