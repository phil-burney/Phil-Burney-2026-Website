---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Phil Burney for Commissioner | Home">
  <!-- Full-width Hero -->
  <section class="landing-hero">
    <div class="landing-hero-bg" id="hero-bg"></div>
    <div class="landing-hero-overlay"></div>
    <div class="landing-hero-content">

      <h1 class="landing-headline">A new way forward.</h1>
      <p class="landing-subhead">Phil Burney for County Commissioner</p>
      <p class="landing-tag">District 5 · Rutherford County</p>
    </div>
  </section>

  <script>
    const bg = document.getElementById('hero-bg');
    window.addEventListener('scroll', () => {
      bg.style.transform = `translateY(${window.scrollY * 0.4}px)`;
    }, { passive: true });
  </script>

  <!-- Meet Phil Section -->
  <section class="section meet-section">
    <h2 class="section-title">Meet Phil Burney</h2>
    <p>
      I've been a lifelong resident of WNC. I grew up in neighboring Polk County, and I've always loved living here. The scenery, the people, and the deep sense of community that living here brings have always kept me coming back.
    </p>
    <p>
      After graduating from NC State with a degree in Computer Science, I found a remote job and bought a home in Rutherford County. I've lived here ever since, and the more I've lived here, the more I believe we can make this an even better place to live, work, and play.
    </p>
    <a href="/about" class="btn btn-outline">Learn More About Phil</a>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="cta-inner">
      <h2>Support the Campaign</h2>
      <p>Grassroots donations keep our campaign moving. Every contribution helps share the message with more voters.</p>
      <div class="cta-actions">
        <a class="btn btn-primary" href="/donations">Donate Today</a>
        <a class="btn btn-outline-light" href="/platform">Learn More</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .meet-section {
    max-width: 800px;
  }

  .meet-section h2 {
    margin-bottom: 1.25rem;
  }

  .meet-section p {
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .meet-section .btn {
    margin-top: 0.5rem;
  }
</style>
