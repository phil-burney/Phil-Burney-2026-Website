---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Phil Burney for Commissioner | Home">
  <section class="hero section">
    <div class="hero-copy">
      <p class="tag">District 5 · Rutherford County</p>
      <h1 class="title main-text">Phil Burney for County Commissioner</h1>
      <p class="slogan subtitle">A new way forward</p>
      <p class="muted">
        Community-first leadership focused on safe neighborhoods, smart growth,
        and accountable local government.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/donations">Donate Today</a>
        <a class="btn btn-outline" href="/platform">Read the Platform</a>
      </div>
    </div>
    <div class="hero-media">
      <img src="/placeholder-hero.svg" alt="Campaign hero placeholder" />
    </div>
  </section>

  <section class="section card highlight border-gradient">
    <div>
      <h2 class="section-title">Meet Phil Burney</h2>
      <p class="muted">
        Lifelong Rutherford County resident and small business advocate committed
        to transparent governance, strong infrastructure, and practical solutions.
      </p>
    </div>
    <div class="profile">
      <img src="/placeholder-headshot.svg" alt="Candidate headshot placeholder" />
      <div>
        <p class="profile-name">Phil Burney</p>
        <p class="muted">County Commissioner Candidate · District 5</p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Priorities for District 5</h2>
    <div class="grid grid-3">
      <article class="card">
        <h3>Smart Growth</h3>
        <p class="muted">Plan development that protects neighborhoods and keeps taxes predictable.</p>
      </article>
      <article class="card">
        <h3>Strong Infrastructure</h3>
        <p class="muted">Invest in roads, public safety, and reliable county services.</p>
      </article>
      <article class="card">
        <h3>Accountability</h3>
        <p class="muted">Open meetings, transparent budgets, and measurable results.</p>
      </article>
    </div>
  </section>

  <section class="section split">
    <div class="card">
      <h2 class="section-title">Join the Movement</h2>
      <p class="muted">
        Help build momentum for District 5. Volunteer, host a meet-and-greet, or
        invite Phil to your community event.
      </p>
      <button class="btn btn-primary">Get Involved</button>
    </div>
    <div class="card">
      <h2 class="section-title">Support the Campaign</h2>
      <p class="muted">
        Grassroots donations keep our campaign moving. Every contribution helps
        share the message with more voters.
      </p>
      <a class="btn btn-outline" href="/donations">Make a Donation</a>
    </div>
  </section>
</BaseLayout>



