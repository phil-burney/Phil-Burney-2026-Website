---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Phil Burney for Commissioner | Home">
  <!-- Full-width Hero with Background Image -->
  <section class="landing-hero">
    <div class="landing-hero-overlay"></div>
    <img src="/placeholder-hero-bg.svg" alt="" class="landing-hero-bg" />
    <div class="landing-hero-content">
      <p class="landing-tag">District 5 · Rutherford County</p>
      <h1 class="landing-headline">A new way forward.</h1>
      <p class="landing-subhead">Phil Burney for County Commissioner</p>
    </div>
  </section>

  <!-- Join / Signup Section -->
  <section class="join-section">
    <div class="join-inner">
      <h2 class="join-title">Join the movement for District 5</h2>
      <p class="join-text">
        Sign up to receive updates, volunteer opportunities, and ways to support the campaign.
      </p>
      <form class="join-form">
        <input type="email" placeholder="Email Address" class="join-input" />
        <input type="text" placeholder="Zip Code" class="join-input join-input-small" />
        <button type="submit" class="btn btn-primary">Sign Up</button>
      </form>
    </div>
  </section>

  <!-- Meet Phil Section -->
  <section class="section meet-section">
    <div class="meet-grid">
      <div class="meet-photo">
        <img src="/placeholder-headshot.svg" alt="Phil Burney" />
      </div>
      <div class="meet-content">
        <h2 class="section-title">Meet Phil Burney</h2>
        <p>
          Lifelong Rutherford County resident and small business advocate committed
          to transparent governance, strong infrastructure, and practical solutions.
        </p>
        <p class="muted">
          Community-first leadership focused on safe neighborhoods, smart growth,
          and accountable local government.
        </p>
        <a href="/platform" class="btn btn-outline">Read the Platform</a>
      </div>
    </div>
  </section>

  <!-- Priorities Section -->
  <section class="section priorities-section">
    <h2 class="section-title centered">Priorities for District 5</h2>
    <div class="priorities-grid">
      <article class="priority-card">
        <div class="priority-icon">🏘️</div>
        <h3>Smart Growth</h3>
        <p class="muted">Plan development that protects neighborhoods and keeps taxes predictable.</p>
      </article>
      <article class="priority-card">
        <div class="priority-icon">🛣️</div>
        <h3>Strong Infrastructure</h3>
        <p class="muted">Invest in roads, public safety, and reliable county services.</p>
      </article>
      <article class="priority-card">
        <div class="priority-icon">📋</div>
        <h3>Accountability</h3>
        <p class="muted">Open meetings, transparent budgets, and measurable results.</p>
      </article>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="cta-inner">
      <h2>Support the Campaign</h2>
      <p>Grassroots donations keep our campaign moving. Every contribution helps share the message with more voters.</p>
      <div class="cta-actions">
        <a class="btn btn-primary" href="/donations">Donate Today</a>
        <a class="btn btn-outline-light" href="/platform">Learn More</a>
      </div>
    </div>
  </section>
</BaseLayout>
