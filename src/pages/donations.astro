---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Donate | Phil Burney">
  <section class="section hero">
    <div>
      <p class="tag">Support the campaign</p>
      <h1 class="title">Fuel the movement in District 5</h1>
      <p class="muted">
        Your contribution powers outreach, community events, and voter engagement across Rutherford County.
      </p>
      <div class="donation-actions">
        <button class="btn btn-primary">$25</button>
        <button class="btn btn-primary">$50</button>
        <button class="btn btn-primary">$100</button>
        <button class="btn btn-outline">Other</button>
      </div>
    </div>
    <img src="/placeholder-hero.svg" alt="Donation hero placeholder" />
  </section>

  <section class="section grid grid-2">
    <article class="card">
      <h2>Donation Form Placeholder</h2>
      <p class="muted">
        Add your payment processor form here. Include required contribution notices and compliance details.
      </p>
      <div class="form-placeholder">
        <p class="muted">[Secure payment form goes here]</p>
      </div>
    </article>
    <article class="card">
      <h2>Where your support goes</h2>
      <p class="muted">Every dollar helps reach more voters and build a stronger District 5.</p>
      <ul>
        <li>Door-to-door outreach materials</li>
        <li>Community events and town halls</li>
        <li>Digital ads and voter guides</li>
        <li>Volunteer training and supplies</li>
      </ul>
    </article>
  </section>

  <section class="section card">
    <h2 class="section-title">Prefer to give by check?</h2>
    <p class="muted">
      Mail contributions to: Friends of Phil Burney, 123 Placeholder St, Rutherford County, TN.
    </p>
    <p class="muted">Please include your name, address, occupation, and employer.</p>
  </section>
</BaseLayout>



